---
export const prerender = true;

import Button from '../components/Button.astro';
import { contact } from '../data/copy';
import { site, whatsappHref } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';

const description = `Escríbele a Sororité por WhatsApp al ${site.phoneDisplay} o al correo ${site.email}.`;
---

<BaseLayout title={contact.title} description={description}>
  <header class="page-hero shell">
    <p class="eyebrow">Contacto</p>
    <h1>{contact.title}</h1>
    <p class="lede">{contact.lede}</p>
  </header>
  <section class="section" aria-label="Canales de contacto">
    <div class="shell split">
      <article class="card">
        <h2>Canales</h2>
        <p>Te respondemos por el mismo medio. Este sitio no guarda el mensaje.</p>
        <div class="cta-stack">
          <Button href={whatsappHref}>{contact.whatsappLabel}</Button>
          <Button href={`mailto:${site.email}`} variant="line">
            {contact.emailLabel}
          </Button>
        </div>
      </article>
      <article class="card" id="talleres">
        <h2>Talleres presenciales</h2>
        <p>
          Hay talleres en Providencia y Puente Alto, Santiago. El mensaje se abre en WhatsApp o en
          tu correo: este sitio no lo guarda.
        </p>
        <Button href={whatsappHref} variant="text" utm="contacto_talleres">
          Preguntar por las próximas fechas
        </Button>
      </article>
    </div>
    <p class="micro shell">
      {site.legalName} · RUT {site.companyTaxId} · Giro: {site.businessActivity} · {site.location}
    </p>
  </section>
</BaseLayout>
