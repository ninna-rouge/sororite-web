---
export const prerender = true;

import Button from '../components/Button.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Página no encontrada"
  description="La dirección no existe en Sororité. Vuelve al inicio o revisa los cursos."
  robots="noindex,follow"
>
  <section class="page-hero shell">
    <h1>No encontramos esta página</h1>
    <p class="lede">El enlace puede estar antiguo o escrito con un error.</p>
    <div class="cta-stack">
      <Button href="/">Ir al inicio</Button>
      <Button href="/cursos" variant="line">
        Ver cursos
      </Button>
    </div>
  </section>
</BaseLayout>
