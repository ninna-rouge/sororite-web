---
export const prerender = true;

import { getImage } from 'astro:assets';
import camila from '../assets/hero/camila.jpg';
import cuatroMujeres from '../assets/fotos-productos-comunidad-reales/11-cuatro-mujeres-riendo-circulo.jpg';
import seisMujeres from '../assets/fotos-productos-comunidad-reales/12-seis-mujeres-circulo-negro.jpg';
import corteJabon from '../assets/fotos-productos-comunidad-reales/10-proceso-corte-jabon-taller.jpg';
import productosPiedra from '../assets/fotos-productos-comunidad-reales/Skincare_products_on_stone_surface_2K_20260930171646.jpg';
import duoBolsas from '../assets/fotos-productos-comunidad-reales/04-duo-bolsas-mural.jpg';
import equipoMural from '../assets/fotos-productos-comunidad-reales/02-equipo-mural-circulo.jpg';
import Button from '../components/Button.astro';
import CtaCierre from '../components/CtaCierre.astro';
import SectionHeading from '../components/SectionHeading.astro';
import FeatureGrid from '../components/kit/FeatureGrid.astro';
import FlipCards from '../components/kit/FlipCards.astro';
import ImageSlot from '../components/kit/ImageSlot.astro';
import MediaSplit from '../components/kit/MediaSplit.astro';
import PageHero from '../components/kit/PageHero.astro';
import QuoteBand from '../components/kit/QuoteBand.astro';
import StatStrip from '../components/kit/StatStrip.astro';
import Timeline from '../components/kit/Timeline.astro';
import { icon } from '../data/icons';
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/paginas/quienes.css';

const description =
  'Somos una escuela de cosmética natural que une ciencia, naturaleza y emprendimiento, creada por mujeres para mujeres.';

const sororidad = await getImage({ src: equipoMural, widths: [480, 760], format: 'webp', quality: 72 });

const stats = [
  { value: '3.500', label: 'estudiantes en 2026', icon: 'people', tone: 'coral' },
  { value: 'Desde 2018', label: 'formando en cosmética natural', icon: 'growth', tone: 'hoja' },
  { value: 'ISP N° 2931/22', label: 'laboratorio con resolución sanitaria', icon: 'flask', tone: 'calipso' },
  { value: 'Capital Abeja', label: 'Sercotec 2023', icon: 'badge', tone: 'durazno' },
] as const;

const hitos = [
  { year: '2015', title: 'Lahuen', text: 'Nace Lahuen Productos Terapéuticos.', tone: 'hoja' },
  { year: '2016', title: 'Sororité.cl', text: 'Venta de materias primas y primeros pasos de la academia.', tone: 'coral' },
  { year: '2018', title: 'Capacitaciones', text: 'Cursos presenciales y online de cosmética natural y terapéutica.', tone: 'durazno' },
  { year: '2021', title: 'Formalización', text: 'Fichas técnicas, maquila y resolución sanitaria.', tone: 'calipso' },
  { year: '2023', title: 'Velas y aromaterapia', text: 'Emprendimientos con velas y aromatizadores.', tone: 'hoja' },
  { year: '2026', title: '3.500 estudiantes', text: 'Online y en talleres de Providencia y Puente Alto.', tone: 'coral' },
] as const;

const trayectoria = [
  {
    icon: 'badge',
    tone: 'coral',
    kicker: 'Base',
    title: 'Enfermera universitaria',
    text: 'Titulada con distinción de la Universidad Pedro de Valdivia.',
  },
  {
    icon: 'flask',
    tone: 'calipso',
    kicker: '+10 años',
    title: 'Formulación cosmética',
    text: 'Experiencia en cosmética natural, emulsiones y productos terapéuticos.',
  },
  {
    icon: 'people',
    tone: 'durazno',
    kicker: '+8 años',
    title: 'Docencia',
    text: 'En el Instituto AIEP, el Instituto IP Chile y sus propios programas.',
  },
  {
    icon: 'leaf',
    tone: 'hoja',
    kicker: 'Formación continua',
    title: 'Siempre aprendiendo',
    text: 'Maquillaje natural (Academia Boreal, 2018) y cosmética capilar avanzada (Cooltiva.cl, 2025).',
  },
] as const;

const proposito = [
  {
    icon: 'compass',
    tone: 'coral',
    kicker: 'Misión',
    title: 'Oficios que dan autonomía',
    text: 'Empoderar a mujeres con oficios creativos (cosmética natural, velas y aromatizadores) para que creen, generen ingresos y construyan con más autonomía.',
  },
  {
    icon: 'horizon',
    tone: 'hoja',
    kicker: 'Visión',
    title: 'Referente en Latinoamérica',
    text: 'Ser referente en formación creativa y cosmética natural en Latinoamérica, por combinar técnica, cercanía y herramientas reales de emprendimiento.',
  },
  {
    icon: 'heart',
    tone: 'durazno',
    kicker: 'Nuestra promesa',
    title: 'Manos, porqué y camino',
    text: 'Aprendes algo que puedes hacer con tus manos, entiendes por qué funciona y sales con herramientas concretas para seguir creando.',
  },
] as const;

const metodo = [
  {
    kicker: 'Ciencia',
    title: 'Entiendes el porqué de cada paso.',
    image: corteJabon,
    imageAlt: 'Dos alumnas cortan barras de jabón artesanal en el taller.',
    backKicker: 'Cómo lo hacemos',
    text: 'Formulación, conservación y pH explicados en lenguaje humano. Enseñamos con evidencia científica y te explicamos el porqué de cada paso.',
    close: 'Para que fabriques con seguridad.',
  },
  {
    kicker: 'Naturaleza',
    title: 'Ingredientes que puedes defender.',
    image: productosPiedra,
    imageAlt: 'Productos de cosmética natural Sororité sobre una mesa de piedra.',
    backKicker: 'Cómo lo hacemos',
    text: 'Estudiamos las materias primas y a los proveedores para elaborar productos libres de ingredientes cuestionados para la salud, sobre todo la hormonal.',
    close: 'Cosmética sólida, menos residuos y envases reutilizados.',
  },
  {
    kicker: 'Emprendimiento',
    title: 'Sales con un camino para vender.',
    image: duoBolsas,
    imageAlt: 'Dos mujeres sonríen con el logo de Sororité y bolsas de la marca.',
    backKicker: 'Cómo lo hacemos',
    text: 'Además de fabricar, aprendes a vender, a formalizar y a sacar la resolución sanitaria en Chile.',
    close: 'Terminas con productos propios y un camino claro.',
  },
];

const valores = [
  {
    icon: 'shield',
    tone: 'hoja',
    title: 'Libre de tóxicos',
    text: 'Ingredientes libres de tóxicos, disruptores hormonales y derivados del petróleo, con información técnica clara para decidir bien.',
  },
  {
    icon: 'badge',
    tone: 'calipso',
    title: 'IFRA / ECOCERT',
    text: 'Lo que decimos sobre normas IFRA y criterios ECOCERT sigue la documentación y el alcance de cada materia prima o producto.',
  },
  {
    icon: 'pin',
    tone: 'durazno',
    title: 'Proveedores locales',
    text: 'Valoramos las extracciones artesanales y los proveedores locales, con foco en calidad, trazabilidad y procedencia.',
  },
  {
    icon: 'heart',
    tone: 'coral',
    title: 'Sororidad',
    text: 'No competimos entre nosotras: fortalecemos el ecosistema. Nos apoyamos y crecemos en comunidad, en el taller y fuera de él.',
  },
] as const;

const medios = ['Radio Universidad de Chile', 'Las Últimas Noticias', 'TVN', 'Sercotec · Capital Abeja 2023'];
---

<BaseLayout title="Quiénes somos" description={description}>
  <PageHero
    eyebrow="Quiénes somos"
    crumbs={[{ label: 'Inicio', href: '/' }, { label: 'Quiénes somos' }]}
    image={cuatroMujeres}
    imageAlt="Cuatro mujeres ríen juntas en el taller de Sororité, una sostiene el logo de la marca."
  >
    <h1 id="ph-titulo">Una historia de <em class="hl-coral hl-brush">autonomía</em>, ciencia y empoderamiento femenino.</h1>
    <Fragment slot="lede">
      <p>
        Somos una escuela de cosmética natural que une ciencia, naturaleza y emprendimiento, creada
        por mujeres para mujeres.
      </p>
    </Fragment>
    <Fragment slot="actions">
      <Button href="/cursos">Ver cursos</Button>
      <Button href="#historia" variant="text">Conoce nuestra historia</Button>
    </Fragment>
  </PageHero>

  <StatStrip label="Sororité en cifras" items={[...stats]} />

  <MediaSplit
    id="historia"
    eyebrow="Nuestra historia"
    image={camila}
    imageAlt="Camila Sánchez Fernández, fundadora de Sororité."
    stamp="Ven, te enseño."
  >
    <h2 slot="title" id="historia-titulo">Emprender no es un sueño para <em class="hl-hoja">unas pocas</em>.</h2>
    <p>
      Camila Sánchez es enfermera universitaria, emprendedora y madre de una niña. A partir de su
      experiencia creó Sororité, para que las mujeres recuperen su autonomía económica y
      transformen lo que saben en un emprendimiento real.
    </p>
    <p>
      Conoce los desafíos de ser madre y emprendedora. Por eso quiere que otras mujeres, sobre todo
      las madres solteras, tengan herramientas para generar ingresos y construir más independencia.
    </p>
    <div class="ms-actions">
      <Button href="#trayectoria" variant="line">Ver su trayectoria</Button>
    </div>
  </MediaSplit>

  <section class="section band-cream" id="trayectoria" aria-labelledby="trayectoria-titulo">
    <div class="shell">
      <SectionHeading
        eyebrow="La fundadora"
        lede="Enfermera universitaria, docente en cosmética natural y emprendimiento, fundadora de Sororité.cl."
      >
        <h2 id="trayectoria-titulo">Camila Sánchez <em class="hl-durazno">Fernández</em>.</h2>
      </SectionHeading>
      <FeatureGrid items={[...trayectoria]} cols={4} />
      <div class="qs-camino">
        <h3 class="qs-camino-titulo">El camino de Sororité</h3>
        <Timeline items={[...hitos]} />
      </div>
    </div>
  </section>

  <section class="section" id="proposito" aria-labelledby="proposito-titulo">
    <div class="shell">
      <SectionHeading eyebrow="Propósito">
        <h2 id="proposito-titulo">Por qué existe <em class="hl-coral">Sororité</em>.</h2>
      </SectionHeading>
      <FeatureGrid items={[...proposito]} cols={3} />
    </div>
  </section>

  <MediaSplit
    id="filosofia"
    eyebrow="Nuestra filosofía"
    image={seisMujeres}
    imageAlt="Seis mujeres del taller posan juntas con el logo de Sororité."
    shape="paisaje"
    flip
    band="band-cream"
  >
    <h2 slot="title" id="filosofia-titulo">Volver a mirarte a <em class="hl-durazno">ti misma</em>.</h2>
    <p>
      «Eres tu mejor inversión» es el corazón de Sororité. Muchas veces el primer paso es reconocer
      las propias capacidades y atreverse a trazar un camino propio.
    </p>
    <p>
      Las mujeres solemos dedicar gran parte de nuestra energía a cuidar a otros, y en ese proceso
      postergamos nuestros proyectos.
    </p>
    <p>
      Invertir en una misma no es egoísmo: es recuperar la confianza y construir mejores
      oportunidades. Cuando una mujer vuelve a creer en sí misma, también transforma su entorno.
    </p>
  </MediaSplit>

  <QuoteBand
    quote="Invertir en ti no es egoísmo: es el primer paso para transformar tu vida y la de tu familia."
    author="Camila Sánchez"
    role="Fundadora de Sororité"
    avatar={camila}
  />

  <section class="section band-cream" id="metodo" aria-labelledby="metodo-titulo">
    <div class="shell">
      <SectionHeading eyebrow="Metodología" lede="Con oficio y cercanía. Gira cada tarjeta para ver cómo lo hacemos.">
        <h2 id="metodo-titulo">Así <em class="hl-hoja">enseñamos</em>.</h2>
      </SectionHeading>
      <FlipCards name="metodo" items={metodo} openLabel="Ver cómo" closeLabel="Volver" />
    </div>
  </section>

  <MediaSplit id="laboratorio" eyebrow="Formación responsable" shape="paisaje" flip>
    <ImageSlot slot="media" label="Laboratorio con resolución sanitaria (4:3)" ratio="4-3" />
    <h2 slot="title" id="laboratorio-titulo">Un laboratorio <em class="hl-calipso">propio</em>.</h2>
    <p>
      Camila cuenta con un laboratorio de bajo riesgo cosmético con resolución sanitaria del ISP
      (N° 2931/22), donde también practican sus estudiantes.
    </p>
    <p>
      Elegimos las materias primas con conciencia, usamos bien cada ingrediente y cuidamos la
      calidad y la seguridad de cada formulación.
    </p>
    <ul class="qs-formatos" aria-label="Formatos">
      <li><span set:html={icon('leaf', 16)} />Cursos online</li>
      <li><span set:html={icon('pin', 16)} />Talleres en Providencia y Puente Alto</li>
      <li><span set:html={icon('growth', 16)} />Acompañamiento a tu proyecto</li>
      <li><span set:html={icon('people', 16)} />Experiencias en comunidad</li>
    </ul>
  </MediaSplit>

  <section class="section band-cream" id="valores" aria-labelledby="valores-titulo">
    <div class="shell">
      <SectionHeading eyebrow="Valores">
        <h2 id="valores-titulo">Lo que <em class="hl-calipso">no transamos</em>.</h2>
      </SectionHeading>
      <div class="qs-valores">
        <figure class="qs-valores-foto">
          <img
            src={sororidad.src}
            srcset={sororidad.srcSet.attribute}
            sizes="(min-width: 960px) 34vw, 92vw"
            width={sororidad.attributes.width}
            height={sororidad.attributes.height}
            alt="Equipo de Sororité frente al mural floral del taller."
            loading="lazy"
            decoding="async"
          />
          <figcaption>En comunidad, en el taller y fuera de él.</figcaption>
        </figure>
        <FeatureGrid items={[...valores]} cols={2} />
      </div>
    </div>
  </section>

  <section class="qs-medios shell" aria-labelledby="medios-titulo">
    <p class="qs-medios-titulo" id="medios-titulo">
      <span set:html={icon('mic', 18)} />
      Han hablado de nuestro trabajo
    </p>
    <ul class="qs-medios-lista">
      {medios.map((m) => <li>{m}</li>)}
    </ul>
  </section>

  <CtaCierre />
</BaseLayout>
