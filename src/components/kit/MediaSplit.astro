---
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import SectionHeading from '../SectionHeading.astro';
import '../../styles/kit/tonos.css';
import '../../styles/kit/media-split.css';

interface Props {
  id: string;
  eyebrow: string;
  image?: ImageMetadata;
  imageAlt?: string;
  /** `retrato` 4:5 o `paisaje` 4:3. */
  shape?: 'retrato' | 'paisaje';
  /** Foto a la derecha. */
  flip?: boolean;
  /** Texto corto del sello que flota sobre la foto. */
  stamp?: string;
  band?: 'band-cream' | '';
}

const {
  id,
  eyebrow,
  image,
  imageAlt = '',
  shape = 'retrato',
  flip = false,
  stamp,
  band = '',
} = Astro.props;

const foto = image
  ? await getImage({ src: image, widths: [480, 760, 1040], format: 'webp', quality: 74 })
  : null;

/** Always Classy no tiene eñe: la tilde se dibuja y el texto real queda para el lector. */
const stampVisual = stamp
  ?.replaceAll('ñ', '<span class="stamp-enie">n</span>')
  .replaceAll('Ñ', '<span class="stamp-enie">N</span>');
---

<section class={`section ms ${band}`} id={id} aria-labelledby={`${id}-titulo`}>
  <div class={`shell ms-grid ${flip ? 'ms-flip' : ''}`}>
    <figure class={`ms-media ms-${shape}`}>
      {foto ? (
        <img
          src={foto.src}
          srcset={foto.srcSet.attribute}
          sizes="(min-width: 960px) 40vw, 92vw"
          width={foto.attributes.width}
          height={foto.attributes.height}
          alt={imageAlt}
          loading="lazy"
          decoding="async"
        />
      ) : (
        <slot name="media" />
      )}
      {stamp && stampVisual && (
        <figcaption class="ms-stamp">
          <span aria-hidden="true" set:html={stampVisual} />
          <span class="visually-hidden">{stamp}</span>
        </figcaption>
      )}
    </figure>
    <div class="ms-copy">
      <SectionHeading eyebrow={eyebrow}>
        <slot name="title" />
      </SectionHeading>
      <div class="ms-body">
        <slot />
      </div>
    </div>
  </div>
</section>
