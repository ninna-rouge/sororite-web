---
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import '../../styles/kit/page-hero.css';

interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  eyebrow: string;
  crumbs?: Crumb[];
  image?: ImageMetadata;
  imageAlt?: string;
  /** Clase de encuadre: `foco-arriba`, `foco-centro` o `foco-abajo`. */
  focus?: 'foco-arriba' | 'foco-centro' | 'foco-abajo';
  titleId?: string;
}

const {
  eyebrow,
  crumbs = [],
  image,
  imageAlt = '',
  focus = 'foco-centro',
  titleId = 'ph-titulo',
} = Astro.props;

const foto = image
  ? await getImage({ src: image, widths: [560, 880, 1240], format: 'webp', quality: 74 })
  : null;
---

<header class={`ph ${foto ? 'ph-con-foto' : 'ph-solo'}`} aria-labelledby={titleId}>
  <div class="shell ph-grid">
    <div class="ph-copy">
      {crumbs.length > 0 && (
        <nav class="crumbs" aria-label="Ruta">
          <ol>
            {crumbs.map((c) => (
              <li>
                {c.href ? (
                  <a href={c.href}>{c.label}</a>
                ) : (
                  <span aria-current="page">{c.label}</span>
                )}
              </li>
            ))}
          </ol>
        </nav>
      )}
      <p class="eyebrow">{eyebrow}</p>
      <slot />
      <div class="ph-lede">
        <slot name="lede" />
      </div>
      {Astro.slots.has('actions') && (
        <div class="ph-actions">
          <slot name="actions" />
        </div>
      )}
    </div>
    {foto && (
      <figure class="ph-media">
        <div class={`ph-foto ${focus}`}>
          <img
            src={foto.src}
            srcset={foto.srcSet.attribute}
            sizes="(min-width: 960px) 44vw, 92vw"
            width={foto.attributes.width}
            height={foto.attributes.height}
            alt={imageAlt}
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </div>
        <img
          class="ph-ramo"
          src="/brand/botanica/cierre/ramo-cosmos.svg"
          alt=""
          width="415"
          height="543"
          aria-hidden="true"
        />
        <img
          class="ph-hoja"
          src="/brand/botanica/cierre/hoja-nervada-2.svg"
          alt=""
          width="51"
          height="78"
          aria-hidden="true"
        />
      </figure>
    )}
  </div>
</header>
