---
import { isCurrent, nav, site } from '../data/site';

const pathname = Astro.url.pathname;
---

<header class="site-header">
  <div class="shell header-bar">
    <a class="brand" href="/">
      <img src={site.logo} width="586" height="416" alt="Sororité, inicio" />
    </a>
    <nav class="site-nav" aria-label="Principal">
      <ul class="nav-desktop">
        {nav.map((item) => (
          <li>
            <a href={item.href} aria-current={isCurrent(pathname, item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
      <details class="nav-mobile">
        <summary role="button">Menú</summary>
        <ul>
          {nav.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isCurrent(pathname, item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </details>
    </nav>
  </div>
</header>
