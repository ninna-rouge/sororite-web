---
import Button from './Button.astro';
---

<section class="hero-banner" aria-labelledby="banner-titulo" data-reveal>
  <picture class="hb-bg">
    <source
      media="(max-width: 767px)"
      type="image/avif"
      srcset="/brand/banner/velas-banner-m.avif"
    />
    <source
      media="(max-width: 767px)"
      type="image/webp"
      srcset="/brand/banner/velas-banner-m.webp"
    />
    <source media="(max-width: 767px)" srcset="/brand/banner/velas-banner-m.jpg" />
    <source type="image/avif" srcset="/brand/banner/velas-banner.avif" />
    <source type="image/webp" srcset="/brand/banner/velas-banner.webp" />
    <img
      src="/brand/banner/velas-banner.jpg"
      alt=""
      width="2400"
      height="915"
      loading="lazy"
      decoding="async"
    />
  </picture>
  <div class="hb-body">
    <p class="hb-eyebrow">Cómo empezar</p>
    <h2 id="banner-titulo" class="hb-title">
      Aprende a formular cosmética natural, jabones y velas{' '}
      <em class="hl-coral hl-brush">desde cero</em>, a tu ritmo y desde tu casa.
    </h2>
    <p class="hb-lead">
      Terminas con productos propios, el criterio para fabricarlos con seguridad y un camino claro
      para emprender.
    </p>
    <div class="hero-actions">
      <Button href="/#oferta" utm="hero_pack">
        Quiero los 6 cursos por $35.000
      </Button>
      <Button href="/#elegir" utm="hero_elegir" variant="text">
        Ayúdame a elegir mi curso →
      </Button>
    </div>
    <p class="hb-trust">
      <svg
        viewBox="0 0 24 24"
        width="16"
        height="16"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <rect x="4" y="11" width="16" height="10" rx="2" pathLength="1" />
        <path d="M8 11V7a4 4 0 0 1 8 0v4" pathLength="1" />
      </svg>
      Pago seguro con Hotmart
    </p>
  </div>
  <ul class="hb-values">
    <li>
      <svg
        viewBox="0 0 24 24"
        width="20"
        height="20"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <rect x="3" y="4" width="18" height="13" rx="2" pathLength="1" />
        <path d="m10 8.5 4 2.5-4 2.5z" pathLength="1" />
        <path d="M8 21h8" pathLength="1" />
      </svg>
      <span>
        <strong>6</strong> cursos online
      </span>
    </li>
    <li>
      <svg
        viewBox="0 0 24 24"
        width="20"
        height="20"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M9 3h6" pathLength="1" />
        <path
          d="M10 3v6.5L4.6 18.2A1.8 1.8 0 0 0 6.1 21h11.8a1.8 1.8 0 0 0 1.5-2.8L14 9.5V3"
          pathLength="1"
        />
        <path d="M7.5 15h9" pathLength="1" />
      </svg>
      <span>
        <strong>Laboratorio</strong> con resolución sanitaria del ISP
      </span>
    </li>
    <li>
      <svg
        viewBox="0 0 24 24"
        width="20"
        height="20"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M12 3 4 6v6c0 5 3.4 8.3 8 9 4.6-.7 8-4 8-9V6z" pathLength="1" />
        <path d="m9 12 2 2 4-4" pathLength="1" />
      </svg>
      <span>
        <strong>Garantía</strong> de 7 días
      </span>
    </li>
  </ul>
</section>
