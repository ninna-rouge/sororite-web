---
import type { CollectionEntry } from 'astro:content';
import { modalityLabel } from '../lib/courses';

interface Props {
  curso: CollectionEntry<'cursos'>;
  heading?: 'h2' | 'h3';
}

const { curso, heading = 'h2' } = Astro.props;
const data = curso.data;
---

<article class="card">
  <img src={data.image} width="640" height="480" alt="" />
  <div class="card-body">
    {data.example && <p class="example-flag">Dato de ejemplo. Esta ficha no está a la venta.</p>}
    <ul class="meta">
      <li>{modalityLabel(data.modality)}</li>
      <li>{data.priceDisplay}</li>
    </ul>
    {heading === 'h3' ? (
      <h3>
        <a href={`/cursos/${data.slug}`}>{data.title}</a>
      </h3>
    ) : (
      <h2>
        <a href={`/cursos/${data.slug}`}>{data.title}</a>
      </h2>
    )}
    <p>{data.summary}</p>
  </div>
</article>
