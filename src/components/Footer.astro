---
import { courses } from '../data/catalog';
import { icon } from '../data/icons';
import { footerNav, headerNav, ingresar, site, whatsappHref } from '../data/site';

const sororite = [
  ...footerNav.filter((i) => i.href === '/quienes-somos' || i.href === '/galeria'),
  ...headerNav.filter((i) => i.href === '/contacto#talleres' || i.href === '/contacto'),
  ingresar,
];
const mark = (name: Parameters<typeof icon>[0]) =>
  icon(name, 18).replace('<svg ', '<svg class="f-ico" ');
---

<footer class="site-footer">
  <img
    class="footer-deco"
    src="/brand/botanica/decoracion-footer.svg"
    alt=""
    aria-hidden="true"
    width="550"
    height="588"
    loading="lazy"
    decoding="async"
  />
  <div class="footer-main">
    <div class="f-brand">
      <a href="/" class="f-logo">
        <img src="/brand/logo-nav.png" width="542" height="374" alt="Sororité, inicio" />
      </a>
      <p>Academia de Cosmética Natural y Emprendimiento · Santiago de Chile</p>
      <div class="f-social">
        <a
          href={site.instagram}
          rel="noopener noreferrer"
          aria-label="Instagram"
          set:html={mark('ig')}
        />
        <a
          href={site.facebook}
          rel="noopener noreferrer"
          aria-label="Facebook"
          set:html={mark('fb')}
        />
      </div>
    </div>
    <nav class="f-col" aria-label="Cursos">
      <h2>Cursos</h2>
      <ul>
        {courses.map((course) => (
          <li>
            <a href={`/#${course.id}`}>{course.name}</a>
          </li>
        ))}
      </ul>
    </nav>
    <nav class="f-col" aria-label="Sororité">
      <h2>Sororité</h2>
      <ul>
        {sororite.map((i) => (
          <li>
            <a href={i.href}>{i.label}</a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="f-col">
      <h2>Contacto</h2>
      <ul class="f-contact">
        <li>
          <a href={`mailto:${site.email}`}>
            <Fragment set:html={mark('mail')} />
            {site.email}
          </a>
        </li>
        <li>
          <a href={whatsappHref}>
            <Fragment set:html={mark('chat')} />
            {site.phoneDisplay}
          </a>
        </li>
        <li>
          <span>
            <Fragment set:html={mark('pin')} />
            {site.location}
          </span>
        </li>
      </ul>
      <p class="f-trust">
        <Fragment set:html={mark('lock')} />
        Pago seguro con Hotmart · Garantía de 7 días
      </p>
    </div>
  </div>
  <div class="footer-bar">
    <p>
      © {new Date().getFullYear()} {site.legalName} · RUT {site.companyTaxId} · Giro:{' '}
      {site.businessActivity} · Representante: {site.representative}
    </p>
    <ul>
      <li>
        <a href="/politica-de-privacidad">Política de privacidad</a>
      </li>
      <li>
        <a href="/terminos">Términos y condiciones</a>
      </li>
      <li>
        <button type="button" class="cookie-preferences" data-cookie-preferences>
          Preferencias de cookies
        </button>
      </li>
    </ul>
  </div>
</footer>
