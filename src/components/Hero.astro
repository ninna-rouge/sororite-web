---
const stats = [
  { value: '3.500', label: 'estudiantes durante 2026' },
  { value: '6', label: 'cursos online' },
  { value: 'Enseña', label: 'una enfermera universitaria' },
  { value: 'Laboratorio', label: 'con resolución sanitaria del ISP' },
];
---

<section class="hero-home" aria-labelledby="hero-titulo">
  <div class="hero-frame">
    <div class="hero-still">
      <video
        class="hero-film"
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        poster="/hero/atelier-poster.jpg"
        width="1920"
        height="1080"
        aria-hidden="true"
      >
        <source src="/hero/atelier.mp4" type="video/mp4" />
      </video>
    </div>
    <div class="hero-panel">
      <p class="eyebrow">Cursos online · Cosmética natural con ciencia</p>
      <div class="hero-copy">
        <h1 id="hero-titulo">
          <span class="hl">Crea tus propios cosméticos</span> <em class="hl">naturales</em> <span class="hl">con ciencia y conviértelos en tu
          emprendimiento.</span>
        </h1>
      </div>
      <aside class="hero-side">
        <img class="hero-mark" src="/brand/logo-oficial.png" alt="" width="586" height="416" />
        <span class="hero-mark-line" aria-hidden="true"></span>
        <div class="stats">
          {stats.map((stat, i) => (
            <div class="stat" style={`--i: ${i}`}>
              <strong>{stat.value}</strong>
              <span>{stat.label}</span>
            </div>
          ))}
        </div>
      </aside>
    </div>
  </div>
</section>

<script>
  const film = document.querySelector('.hero-film');
  if (film instanceof HTMLVideoElement && matchMedia('(prefers-reduced-motion: reduce)').matches) {
    film.removeAttribute('autoplay');
    film.pause();
  }
</script>
