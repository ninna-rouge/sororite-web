---
const stats = [
  { value: '3.500', label: 'estudiantes durante 2026' },
  { value: '6', label: 'cursos online' },
  { value: 'Enseña', label: 'una enfermera universitaria' },
  { value: 'Laboratorio', label: 'con resolución sanitaria del ISP' },
];
---

<section class="hero-home" aria-labelledby="hero-titulo">
  <div class="hero-frame">
    <div class="hero-still">
      <picture>
        <source media="(max-width: 767px)" srcset="/hero/atelier-poster-m.jpg" />
        <img
          class="hero-poster"
          src="/hero/atelier-poster.jpg"
          alt=""
          width="1920"
          height="1080"
          fetchpriority="high"
          decoding="async"
        />
      </picture>
      <video
        class="hero-film"
        muted
        loop
        playsinline
        preload="none"
        width="1920"
        height="1080"
        aria-hidden="true"
        data-src="/hero/atelier.mp4"
      ></video>
    </div>
    <div class="hero-panel">
      <p class="eyebrow">Cursos online · Cosmética natural con ciencia</p>
      <div class="hero-copy">
        <h1 id="hero-titulo">
          <span class="hl">Crea tus propios cosméticos</span> <em class="hl">naturales</em>{' '}
          <span class="hl">con ciencia y conviértelos en tu emprendimiento.</span>
        </h1>
      </div>
      <aside class="hero-side">
        <img class="hero-mark" src="/brand/logo-oficial.png" alt="" width="586" height="416" />
        <span class="hero-mark-line" aria-hidden="true"></span>
        <div class="stats">
          {stats.map((stat) => (
            <div class="stat">
              <strong>{stat.value}</strong>
              <span>{stat.label}</span>
            </div>
          ))}
        </div>
      </aside>
    </div>
  </div>
</section>

<script>
  const film = document.querySelector('.hero-film');
  if (film instanceof HTMLVideoElement && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const start = () => {
      const source = film.dataset.src;
      if (!source || film.getAttribute('src')) return;
      film.src = source;
      film.preload = 'auto';
      film.addEventListener('playing', () => film.classList.add('is-playing'), { once: true });
      void film.play().catch(() => undefined);
    };
    const whenIdle = () => {
      const idle = window.requestIdleCallback?.bind(window);
      if (idle) idle(start, { timeout: 2000 });
      else setTimeout(start, 400);
    };
    if (document.readyState === 'complete') whenIdle();
    else window.addEventListener('load', whenIdle, { once: true });
  }
</script>
