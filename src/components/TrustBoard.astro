---
const notes = [
  {
    icon: 'flask',
    tone: 'coral',
    kicker: 'ISP N° 2931/22',
    title: 'Laboratorio con resolución sanitaria',
    text: 'Laboratorio de bajo riesgo cosmético autorizado por el ISP, donde también practican nuestras estudiantes.',
  },
  {
    icon: 'steth',
    tone: 'hoja',
    kicker: 'Desde 2018',
    title: 'Una enfermera universitaria te enseña',
    text: 'Camila Sánchez explica el porqué de cada paso: pH, conservación y estabilidad, en lenguaje simple.',
  },
  {
    icon: 'leaf',
    tone: 'durazno',
    kicker: 'Materias primas',
    title: 'Ingredientes libres de tóxicos',
    text: 'Aprendes a elegir materias primas libres de tóxicos y disruptores hormonales, con información técnica clara.',
  },
];
const icons: Record<string, string> = {
  flask: '<path d="M9 3h6"/><path d="M10 3v6.5L4.6 18.2A1.8 1.8 0 0 0 6.1 21h11.8a1.8 1.8 0 0 0 1.5-2.8L14 9.5V3"/><path d="M7.5 15h9"/>',
  steth: '<path d="M5 3v5a5 5 0 0 0 10 0V3"/><path d="M10 13v2a5 5 0 0 0 10 0v-1"/><circle cx="20" cy="12" r="2"/>',
  leaf: '<path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.5 19 2c1 2 2 4.2 2 8 0 5.5-4.8 10-10 10Z"/><path d="M2 21c0-3 1.9-5.4 5.1-6C9.5 14.5 12 13 13 12"/>',
};
const svg = (d: string) =>
  `<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${d}</svg>`;
---

<div class="tb">
  <div class="tb-side">
    <ul class="tb-notes stagger">
      {
        notes.map((note) => (
          <li class={`tb-note tone-${note.tone}`} data-reveal>
            <span class="tb-ico" set:html={svg(icons[note.icon])} />
            <div>
              <p class="tb-kicker">{note.kicker}</p>
              <h3>{note.title}</h3>
              <p class="tb-text">{note.text}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="tb-media">
    <article class="tb-film" data-reveal data-tb-film>
      <video
        class="tb-video"
        muted
        loop
        playsinline
        preload="none"
        poster="/respaldo/taller-poster.jpg"
        width="1280"
        height="534"
        aria-hidden="true"
      >
        <source src="/respaldo/taller.mp4" type="video/mp4" />
      </video>
      <div class="tb-stat">
        <p class="tb-kicker">Online y presencial</p>
        <h3>
          <span class="tb-figure">3.500</span>
          <span class="tb-line">estudiantes durante 2026</span>
        </h3>
      </div>
      <button class="tb-toggle" type="button" aria-pressed="false" aria-label="Pausar el video" data-tb-toggle>
        <span class="tb-toggle-icon" aria-hidden="true"></span>
      </button>
    </article>
  </div>
</div>

<script>
  function initFilm(card: HTMLElement) {
    const video = card.querySelector('video');
    const toggle = card.querySelector<HTMLButtonElement>('[data-tb-toggle]');
    if (!video || !toggle || card.dataset.tbBound) return;
    card.dataset.tbBound = 'true';
    video.muted = true;

    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let wanted = !reduce;
    let visible = false;

    const sync = () => {
      card.classList.toggle('is-paused', !wanted);
      toggle.setAttribute('aria-pressed', String(!wanted));
      toggle.setAttribute('aria-label', wanted ? 'Pausar el video' : 'Reproducir el video');
      if (wanted && visible) void video.play().catch(() => undefined);
      else video.pause();
    };

    toggle.addEventListener('click', () => {
      wanted = !wanted;
      sync();
    });

    if ('IntersectionObserver' in window) {
      new IntersectionObserver(
        (entries) => {
          visible = entries.some((entry) => entry.isIntersecting);
          sync();
        },
        { threshold: 0.25 },
      ).observe(card);
    } else {
      visible = true;
    }
    sync();
  }

  const boot = () => document.querySelectorAll<HTMLElement>('[data-tb-film]').forEach(initFilm);
  boot();
  document.addEventListener('astro:page-load', boot);
</script>
